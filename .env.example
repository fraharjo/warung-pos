# Database PostgreSQL (opsional untuk local dev; WAJIB diisi saat deploy di Vercel, misalnya dari Neon / Supabase)
# Jika kosong saat jalan lokal, aplikasi otomatis menyimpan data ke .local-data/db.json
DATABASE_URL=

# Secret acak untuk menandatangani cookie login (ganti dengan string panjang acak di Vercel)
AUTH_SECRET=ganti-dengan-secret-panjang-acak-minimal-32-karakter
